# ─────────────────────────────────────────────────────────────────────────────
# Firebase Configuration — Golden Scissor Spa & Saloon (CLIENT)
# ─────────────────────────────────────────────────────────────────────────────
# Copy the values from your Firebase Console:
#   https://console.firebase.google.com  →  Project Settings  →  Your Apps
#
# NOTE: All client-side env vars MUST start with VITE_ to be exposed by Vite
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
# VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID   # optional (Analytics)
