PORT=5000
NODE_ENV=development

# MongoDB — Replace with your Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/golden-scissor-spa?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary — Create free account at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail SMTP — use App Password if 2FA is enabled)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Golden Scissor Spa <noreply@goldenscissorspa.com>

# Client URL (for CORS + email reset links)
CLIENT_URL=http://localhost:5173

# WhatsApp Business number (for wa.me deep links)
WHATSAPP_NUMBER=12125550199

# WhatsApp Cloud API (Official Meta Integration)
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_BUSINESS_ACCOUNT_ID
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
WHATSAPP_API_VERSION=v17.0
WHATSAPP_TEMPLATE_NAME=booking_confirmation

# Centralized Business Info (for backend WhatsApp template variables)
BUSINESS_NAME=Golden Scissor Digital Lounge
BUSINESS_LOCATION=123 Sanctuary Boulevard, Gilded Noir District, Mumbai, MH - 400001

